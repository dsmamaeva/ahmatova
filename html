            background-size: cover;
            background-position: center 16px;
            background-repeat: no-repeat;
            position: relative;
        }
        .hero-gradient-bg {
            position: absolute;
            left: 0;
            bottom: 0;
            width: 100vw;
            height: 515px;
            pointer-events: none;
            z-index: 2;
            background: linear-gradient(to top, #000 0%, rgba(0,0,0,0) 100%);
